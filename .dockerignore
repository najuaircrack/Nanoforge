# Build context is a source allowlist. Private and runtime state is excluded by default.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!LICENSE.md
!requirements.txt
!src/
!src/**
!configs/
!configs/**
!docs/
!docs/**
!scripts/
!scripts/**
# Exclude local/private source-adjacent material even under allowlisted directories.
**/__pycache__/**
**/*.pyc
**/*.egg-info/**
**/.env
**/.env.*
configs/nashwa-*.yaml
scripts/*nashwa*.py
**/*.log
**/*.pyd
**/*.so
**/*.dll
**/*.pt
**/*.pth
**/*.bin
**/*.gguf
**/*.onnx
